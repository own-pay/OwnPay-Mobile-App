# OwnPay Console release upload key (NEVER commit the real keystore.properties).
# See the "Building the Production Release" section of README.md for the full release runbook.
# The upload keystore itself must also stay out of git; it is referenced by storeFile and never committed.
storeFile=app/upload-keystore.jks
storePassword=changeit
keyAlias=ownpay-upload
keyPassword=changeit
